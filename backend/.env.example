# API Configuration
PROJECT_NAME="Cafe Management API"
API_V1_STR="/api/v1"

# Security
# Generate a secure key later using: openssl rand -hex 32
SECRET_KEY="your-super-secret-key-replace-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days

# PostgreSQL Database
# Format: postgresql://user:password@localhost:5432/dbname
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cafe_db"

# Cloudinary Integration
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"